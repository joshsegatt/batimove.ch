{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "devCommand": "npm run dev",
    "installCommand": "npm install",
    "redirects": [
        {
            "source": "/pricing",
            "destination": "/quote",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/demenagement-geneve",
            "destination": "/demenagement-geneve/index.html"
        },
        {
            "source": "/demenagement-lausanne",
            "destination": "/demenagement-lausanne/index.html"
        },
        {
            "source": "/demenagement-vaud",
            "destination": "/demenagement-vaud/index.html"
        },
        {
            "source": "/services",
            "destination": "/services/index.html"
        },
        {
            "source": "/calculator",
            "destination": "/calculator/index.html"
        },
        {
            "source": "/contact",
            "destination": "/contact/index.html"
        },
        {
            "source": "/quote",
            "destination": "/quote/index.html"
        },
        {
            "source": "/privacy",
            "destination": "/privacy/index.html"
        },
        {
            "source": "/terms",
            "destination": "/terms/index.html"
        },
        {
            "source": "/legal",
            "destination": "/legal/index.html"
        },
        {
            "source": "/calculator/checkout",
            "destination": "/calculator/checkout/index.html"
        },
        {
            "source": "/debarras",
            "destination": "/debarras/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail",
            "destination": "/nettoyage-fin-de-bail/index.html"
        },
        {
            "source": "/garde-meubles",
            "destination": "/garde-meubles/index.html"
        },
        {
            "source": "/debarras-geneve",
            "destination": "/debarras-geneve/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-geneve",
            "destination": "/nettoyage-fin-de-bail-geneve/index.html"
        },
        {
            "source": "/debarras-carouge",
            "destination": "/debarras-carouge/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-carouge",
            "destination": "/nettoyage-fin-de-bail-carouge/index.html"
        },
        {
            "source": "/debarras-vaud",
            "destination": "/debarras-vaud/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-vaud",
            "destination": "/nettoyage-fin-de-bail-vaud/index.html"
        },
        {
            "source": "/debarras-lausanne",
            "destination": "/debarras-lausanne/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-lausanne",
            "destination": "/nettoyage-fin-de-bail-lausanne/index.html"
        },
        {
            "source": "/debarras-renens",
            "destination": "/debarras-renens/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-renens",
            "destination": "/nettoyage-fin-de-bail-renens/index.html"
        },
        {
            "source": "/debarras-nyon",
            "destination": "/debarras-nyon/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-nyon",
            "destination": "/nettoyage-fin-de-bail-nyon/index.html"
        },
        {
            "source": "/debarras-morges",
            "destination": "/debarras-morges/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-morges",
            "destination": "/nettoyage-fin-de-bail-morges/index.html"
        },
        {
            "source": "/debarras-vevey",
            "destination": "/debarras-vevey/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-vevey",
            "destination": "/nettoyage-fin-de-bail-vevey/index.html"
        },
        {
            "source": "/debarras-montreux",
            "destination": "/debarras-montreux/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-montreux",
            "destination": "/nettoyage-fin-de-bail-montreux/index.html"
        },
        {
            "source": "/debarras-yverdon-les-bains",
            "destination": "/debarras-yverdon-les-bains/index.html"
        },
        {
            "source": "/nettoyage-fin-de-bail-yverdon-les-bains",
            "destination": "/nettoyage-fin-de-bail-yverdon-les-bains/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=()"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' https://cdn.tailwindcss.com https://esm.sh https://api.emailjs.com https://www.googletagmanager.com https://tagmanager.google.com https://www.google-analytics.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://*.g.doubleclick.net https://www.gstatic.com 'unsafe-inline' 'unsafe-eval'; script-src-elem 'self' https://cdn.tailwindcss.com https://esm.sh https://api.emailjs.com https://www.googletagmanager.com https://tagmanager.google.com https://www.google-analytics.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://*.g.doubleclick.net https://www.gstatic.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline' blob:; style-src-elem 'self' https://fonts.googleapis.com 'unsafe-inline' blob:; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://batimove.ch https://*.batimove.ch https://images.unsplash.com https://raw.githubusercontent.com https://upload.wikimedia.org https://www.transparenttextures.com https://i.pravatar.cc https://*.googletagmanager.com https://*.google-analytics.com https://*.google.com https://*.google.ch https://*.googleadservices.com https://*.doubleclick.net https://*.g.doubleclick.net https://pagead2.googlesyndication.com https://*.googlesyndication.com data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.emailjs.com https://esm.sh https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://ad.doubleclick.net https://*.doubleclick.net https://googleads.g.doubleclick.net https://*.g.doubleclick.net https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.google.com https://*.google.ch https://*.googleadservices.com https://stats.g.doubleclick.net; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https://tagassistant.google.com https://*.google.com https://*.doubleclick.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.(png|jpg|jpeg|gif|ico|svg|webp|avif|mp4|woff|woff2|ttf|eot)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/(sw\\.js|site\\.webmanifest)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/(quote|calculator-checkout|contact)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
                }
            ]
        }
    ]
}
